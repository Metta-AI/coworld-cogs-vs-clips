ARG METTASCOPE_BUILDER_PLATFORM=linux/amd64
ARG GAME_RUNTIME_PLATFORM=linux/amd64
FROM --platform=${METTASCOPE_BUILDER_PLATFORM} emscripten/emsdk:4.0.15 AS mettascope-builder

ARG NIMBY_VERSION=0.1.26
ARG NIM_VERSION=2.2.6
ARG METTAGRID_VERSION=0.26.21
ARG METTAGRID_SDIST_SHA256=74964995622dff92c72ff978e8b5ec6cb8d4906e50cfc0c5c5d28bdb9b2d246a
ARG METTAGRID_ASSETS_SHA256=2ab91ae1a5eaa59a559402e2bc15989dd65add9467c9a9487281cd966516fea6

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    unzip \
    && rm -rf /var/lib/apt/lists/*

RUN ARCH="$(uname -m)" && \
    if [ "${ARCH}" = "aarch64" ]; then NIMBY_ARCH="Arm64"; else NIMBY_ARCH="X64"; fi && \
    curl -fsSL "https://github.com/treeform/nimby/releases/download/${NIMBY_VERSION}/nimby-Linux-${NIMBY_ARCH}" \
        -o /usr/local/bin/nimby && \
    chmod +x /usr/local/bin/nimby && \
    nimby use "${NIM_VERSION}" && \
    chmod +x /root/.nimby/nim/bin/nimble

ENV PATH="/root/.nimby/nim/bin:${PATH}"

WORKDIR /mettascope
RUN curl -fsSL "https://files.pythonhosted.org/packages/source/m/mettagrid/mettagrid-${METTAGRID_VERSION}.tar.gz" \
        -o /tmp/mettagrid.tar.gz && \
    echo "${METTAGRID_SDIST_SHA256}  /tmp/mettagrid.tar.gz" | sha256sum --check && \
    mkdir /tmp/mettagrid && \
    tar -xzf /tmp/mettagrid.tar.gz -C /tmp/mettagrid --strip-components=1 && \
    cp -a /tmp/mettagrid/nim/mettascope/. . && \
    curl -fsSL "https://softmax-public.s3.amazonaws.com/mettagrid-assets/v${METTAGRID_VERSION}/mettagrid-assets.zip" \
        -o /tmp/mettagrid-assets.zip && \
    echo "${METTAGRID_ASSETS_SHA256}  /tmp/mettagrid-assets.zip" | sha256sum --check && \
    rm -rf data && \
    unzip -q /tmp/mettagrid-assets.zip && \
    rm -rf /tmp/mettagrid /tmp/mettagrid.tar.gz /tmp/mettagrid-assets.zip
RUN nimby sync -g nimby.lock
RUN nim c -d:emscripten -d:release src/mettascope.nim && \
    test -f dist/mettascope.html && \
    test -f dist/mettascope.js && \
    test -f dist/mettascope.wasm && \
    test -f dist/mettascope.data && \
    ls -lh dist/

FROM scratch AS replay-viewer-bundle
COPY replay-viewer/index.html /index.html
COPY --from=mettascope-builder /mettascope/dist /mettascope
CMD ["/index.html"]

FROM --platform=${GAME_RUNTIME_PLATFORM} python:3.12-slim

ARG COWORLD_VERSION=0.1.34
ARG METTAGRID_VERSION=0.26.21

RUN pip install --no-cache-dir \
    "coworld==${COWORLD_VERSION}" \
    "fastapi>=0.115.5" \
    "mettagrid==${METTAGRID_VERSION}" \
    "uvicorn[standard]>=0.34.2"

COPY pyproject.toml README.md /tmp/cogsguard/
COPY src /tmp/cogsguard/src
RUN pip install --no-cache-dir --no-deps /tmp/cogsguard && \
    rm -rf /tmp/cogsguard

WORKDIR /app
COPY --from=mettascope-builder /mettascope/dist /app/mettascope
COPY coworld/game/client /app/client
COPY coworld/game/server.py /app/server.py

CMD ["python", "/app/server.py"]
