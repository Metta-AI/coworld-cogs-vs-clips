{
  "$schema": "https://raw.githubusercontent.com/Metta-AI/coworld/main/src/coworld/coworld_manifest_schema.json",
  "tags": [
    "multi-agent",
    "resource-management",
    "strategy"
  ],
  "game": {
    "name": "cogs_vs_clips",
    "description": "Cogs vs Clips and Four Score packaged as one Coworld backed by CogsGuard and MettaGrid.",
    "owner": "coworld@softmax.com",
    "replay_viewer": {
      "bundle": "static-replay-viewer"
    },
    "runnable": {
      "type": "game",
      "image": "{{GAME_IMAGE}}",
      "run": [
        "python",
        "/app/server.py"
      ],
      "source_url": "https://github.com/Metta-AI/coworld-cogs-vs-clips/tree/main"
    },
    "config_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokens",
        "players",
        "mission",
        "max_steps",
        "seed",
        "step_seconds"
      ],
      "properties": {
        "tokens": {
          "type": "array",
          "minItems": 8,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "players": {
          "type": "array",
          "minItems": 8,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "mission": {
          "type": "string",
          "enum": [
            "machina_1",
            "cogsguard",
            "four_score"
          ]
        },
        "max_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "step_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      },
      "oneOf": [
        {
          "properties": {
            "tokens": {
              "minItems": 8,
              "maxItems": 8
            },
            "players": {
              "minItems": 8,
              "maxItems": 8
            },
            "mission": {
              "enum": [
                "machina_1",
                "cogsguard"
              ]
            }
          }
        },
        {
          "properties": {
            "tokens": {
              "minItems": 32,
              "maxItems": 32
            },
            "players": {
              "minItems": 32,
              "maxItems": 32
            },
            "mission": {
              "const": "four_score"
            }
          }
        }
      ]
    },
    "results_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scores",
        "steps",
        "mission"
      ],
      "properties": {
        "scores": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "number"
          }
        },
        "steps": {
          "type": "integer",
          "minimum": 0
        },
        "mission": {
          "type": "string",
          "enum": [
            "machina_1",
            "cogsguard",
            "four_score"
          ]
        }
      }
    },
    "protocols": {
      "player": {
        "type": "uri",
        "value": "https://github.com/Metta-AI/coworld-cogs-vs-clips/blob/main/coworld/game/docs/player_protocol_spec.md"
      },
      "global": {
        "type": "uri",
        "value": "https://github.com/Metta-AI/coworld-cogs-vs-clips/blob/main/coworld/game/docs/global_protocol_spec.md"
      }
    },
    "docs": {
      "readme": {
        "type": "uri",
        "value": "https://github.com/Metta-AI/coworld-cogs-vs-clips/blob/main/README.md"
      },
      "pages": [
        {
          "id": "rules.md",
          "title": "rules.md",
          "content": {
            "type": "uri",
            "value": "https://softmax.com/play_cogsvsclips.md#game-rules"
          }
        },
        {
          "id": "play_cogsvsclips.md",
          "title": "play_cogsvsclips.md",
          "content": {
            "type": "uri",
            "value": "https://softmax.com/play_cogsvsclips.md"
          }
        },
        {
          "id": "game-source",
          "title": "game source",
          "content": {
            "type": "uri",
            "value": "https://github.com/Metta-AI/coworld-cogs-vs-clips/tree/main"
          }
        },
        {
          "id": "player",
          "title": "player.md",
          "content": {
            "type": "uri",
            "value": "https://github.com/Metta-AI/coworld-cogs-vs-clips/tree/main/coworld/player"
          }
        }
      ]
    }
  },
  "player": [
    {
      "id": "reference-player",
      "name": "Reference Player",
      "type": "player",
      "image": "{{PLAYER_IMAGE}}",
      "run": [
        "python",
        "/app/coworld_reference_player.py"
      ],
      "source_url": "https://github.com/Metta-AI/coworld-cogs-vs-clips/tree/main/coworld/player",
      "description": "CogsGuard Coworld reference player for Cogs vs Clips and Four Score over coworld.player.v1."
    }
  ],
  "commissioner": [
    {
      "id": "cogs-vs-clips-commissioner",
      "type": "commissioner",
      "name": "Cogs vs Clips Commissioner",
      "description": "Cogs vs Clips commissioner with slot-balanced competition rounds and isolated qualifier rounds.",
      "image": "{{COGS_VS_CLIPS_COMMISSIONER_IMAGE}}",
      "source_url": "https://github.com/Metta-AI/coworld-cogs-vs-clips/tree/main/commissioner/commissioners/ruleset_strategy_commissioner"
    },
    {
      "id": "four-score-commissioner",
      "type": "commissioner",
      "name": "Four Score Commissioner",
      "description": "Four Score commissioner with four-team competition rounds and isolated qualifier rounds.",
      "image": "{{FOUR_SCORE_COMMISSIONER_IMAGE}}",
      "source_url": "https://github.com/Metta-AI/coworld-cogs-vs-clips/tree/main/commissioner/commissioners/ruleset_strategy_commissioner"
    }
  ],
