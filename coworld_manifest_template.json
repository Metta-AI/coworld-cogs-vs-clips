{
  "$schema": "https://raw.githubusercontent.com/Metta-AI/coworld/main/src/coworld/coworld_manifest_schema.json",
  "tags": [
    "multi-agent",
    "resource-management",
    "strategy"
  ],
  "game": {
    "name": "cogs_vs_clips",
    "description": "Cogs vs Clips and FourScore in one Coworld, with MettaGrid and pinned Polyworld implementations.",
    "owner": "coworld@softmax.com",
    "replay_viewer": {
      "bundle": "static-replay-viewer"
    },
    "runnable": {
      "type": "game",
      "image": "{{POLYWORLD_COOPERATIVE_IMAGE}}",
      "source_url": "https://github.com/softmax-universe/polyworld-cogs-vs-clips/tree/ae5bc282e9d96d9988d0fdff67e193b9927e2d0a"
    },
    "config_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokens",
        "players",
        "seed"
      ],
      "properties": {
        "tokens": {
          "type": "array",
          "minItems": 8,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "players": {
          "type": "array",
          "minItems": 8,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "mission": {
          "type": "string",
          "enum": [
            "machina_1",
            "cogsguard",
            "four_score"
          ]
        },
        "max_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "step_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "max_ticks": {
          "type": "integer",
          "const": 10000
        },
        "map_seed": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        }
      },
      "oneOf": [
        {
          "required": [
            "tokens",
            "players",
            "mission",
            "max_steps",
            "seed",
            "step_seconds"
          ],
          "oneOf": [
            {
              "properties": {
                "tokens": {
                  "minItems": 8,
                  "maxItems": 8
                },
                "players": {
                  "minItems": 8,
                  "maxItems": 8
                },
                "mission": {
                  "enum": [
                    "machina_1",
                    "cogsguard"
                  ]
                }
              }
            },
            {
              "properties": {
                "tokens": {
                  "minItems": 32,
                  "maxItems": 32
                },
                "players": {
                  "minItems": 32,
                  "maxItems": 32
                },
                "mission": {
                  "const": "four_score"
                }
              }
            }
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "max_ticks"
                ]
              },
              {
                "required": [
                  "map_seed"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "max_ticks",
            "map_seed"
          ],
          "properties": {
            "tokens": {
              "minItems": 8,
              "maxItems": 8
            },
            "players": {
              "minItems": 8,
              "maxItems": 8
            },
            "seed": {
              "maximum": 2147483647
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "mission"
                ]
              },
              {
                "required": [
                  "max_steps"
                ]
              },
              {
                "required": [
                  "step_seconds"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "max_ticks"
          ],
          "properties": {
            "tokens": {
              "minItems": 32,
              "maxItems": 32
            },
            "players": {
              "minItems": 32,
              "maxItems": 32
            },
            "seed": {
              "maximum": 2147483647
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "mission"
                ]
              },
              {
                "required": [
                  "max_steps"
                ]
              },
              {
                "required": [
                  "step_seconds"
                ]
              },
              {
                "required": [
                  "map_seed"
                ]
              }
            ]
          }
        }
      ]
    },
    "results_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": [
        "scores"
      ],
      "properties": {
        "scores": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "number"
          }
        }
      },
      "oneOf": [
        {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scores",
            "steps",
            "mission"
          ],
          "properties": {
            "scores": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "number"
              }
            },
            "steps": {
              "type": "integer",
              "minimum": 0
            },
            "mission": {
              "type": "string",
              "enum": [
                "machina_1",
                "cogsguard",
                "four_score"
              ]
            },
            "replay_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scores",
            "ticks",
            "seed",
            "outcome"
          ],
          "properties": {
            "scores": {
              "type": "array",
              "minItems": 8,
              "maxItems": 32,
              "items": {
                "type": "number",
                "minimum": 0
              },
              "oneOf": [
                {
                  "minItems": 8,
                  "maxItems": 8
                },
                {
                  "minItems": 32,
                  "maxItems": 32
                }
              ]
            },
            "ticks": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "seed": {
              "type": "integer"
            },
            "outcome": {
              "type": "string"
            },
            "banked_gold": {
              "type": "array",
              "maxItems": 0,
              "items": {
                "type": "integer"
              }
            },
            "returned": {
              "type": "array",
              "maxItems": 0,
              "items": {
                "type": "boolean"
              }
            }
          }
        }
      ]
    },
    "protocols": {
      "player": {
        "type": "uri",
        "value": "https://github.com/Metta-AI/coworld-cogs-vs-clips/blob/main/coworld/game/docs/player_protocol_spec.md"
      },
      "global": {
        "type": "uri",
        "value": "https://github.com/Metta-AI/coworld-cogs-vs-clips/blob/main/coworld/game/docs/global_protocol_spec.md"
      }
    },
    "docs": {
      "readme": {
        "type": "uri",
        "value": "https://github.com/Metta-AI/coworld-cogs-vs-clips/blob/main/README.md"
      },
      "pages": [
        {
          "id": "rules.md",
          "title": "rules.md",
          "content": {
            "type": "uri",
            "value": "https://softmax.com/play_cogsvsclips.md#game-rules"
          }
        },
        {
          "id": "play_cogsvsclips.md",
          "title": "play_cogsvsclips.md",
          "content": {
            "type": "uri",
            "value": "https://softmax.com/play_cogsvsclips.md"
          }
        },
        {
          "id": "game-source",
          "title": "game source",
          "content": {
            "type": "uri",
            "value": "https://github.com/Metta-AI/coworld-cogs-vs-clips/tree/main"
          }
        },
        {
          "id": "player",
          "title": "player.md",
          "content": {
            "type": "uri",
            "value": "https://github.com/Metta-AI/coworld-cogs-vs-clips/tree/main/coworld/player"
          }
        }
      ]
    },
    "player_runtime": [
      "platform-hosted",
      "game-hosted"
    ]
  },
