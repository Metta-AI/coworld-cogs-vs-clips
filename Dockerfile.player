ARG PLAYER_RUNTIME_PLATFORM=linux/amd64
FROM --platform=${PLAYER_RUNTIME_PLATFORM} python:3.12-slim

ENV OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1

RUN pip install --no-cache-dir \
    pydantic \
    websockets

WORKDIR /app
COPY coworld/player/policy_player.py /app/coworld_reference_player.py

CMD ["python", "/app/coworld_reference_player.py"]
